AUTH_MODE=token
# 生图站 · 服务器上的配置（由本地生成，权限 600）
# 同机 Docker 内网直连 new-api，不走公网、不涉及 TLS
RELAY_BASE=http://127.0.0.1:3001
RELAY_TOKEN=sk-cjAyC5BSbhtcBMHt2d4VzG0B43Kv1v1NS2pRCgM3FEC8g82q
RELAY_MODEL=gpt-5.6-sol
PORT=8788
DATA_DIR=/data
# 1 核机器，稳住：一次只画一张
MAX_CONCURRENT=6
MIN_GAP_MS=5000
MAX_REFS=4
MAX_REF_MB=8
# 每人一个口令（名字和口令里不要有冒号/逗号）
# ACCESS_PASSWORD= 已停用（改用 AUTH_MODE=token）
# 登录方式：只用中转站令牌（AUTH_MODE=token），不需要名单/用户名
REQUEST_TIMEOUT_MS=300000
IMAGE_TTL_DAYS=60
CLEANUP_INTERVAL_HOURS=12
WEBP=1
WEBP_MAX_W=1600
WEBP_QUALITY=82
